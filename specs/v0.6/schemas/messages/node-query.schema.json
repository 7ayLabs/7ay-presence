{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://7ay.io/schemas/v0.6/messages/node-query.schema.json",
  "title": "NODE_QUERY Message",
  "description": "Request nodes matching criteria (0x02)",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "const": "0.6.0",
      "description": "Protocol version"
    },
    "type": {
      "type": "integer",
      "const": 2,
      "description": "Message type (NODE_QUERY = 0x02)"
    },
    "sender": {
      "type": "object",
      "properties": {
        "address": {
          "type": "string",
          "pattern": "^0x[a-fA-F0-9]{40}$"
        },
        "publicKey": {
          "type": "string",
          "pattern": "^0x[a-fA-F0-9]{128}$"
        }
      },
      "required": ["address"],
      "additionalProperties": false
    },
    "epochId": {
      "type": "string",
      "pattern": "^[0-9]+$",
      "description": "Epoch context (uint256 as string)"
    },
    "timestamp": {
      "type": "integer",
      "minimum": 0,
      "description": "Unix timestamp (seconds)"
    },
    "nonce": {
      "type": "string",
      "pattern": "^0x[a-fA-F0-9]{64}$",
      "description": "Random 32-byte nonce for replay protection"
    },
    "signature": {
      "type": "string",
      "pattern": "^0x[a-fA-F0-9]{130}$",
      "description": "ECDSA signature (65 bytes)"
    },
    "payload": {
      "type": "object",
      "properties": {
        "filter": {
          "type": "object",
          "properties": {
            "role": {
              "type": "string",
              "enum": ["participant", "validator"],
              "description": "Filter by role"
            },
            "capabilities": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["discovery", "messaging", "stateSync"]
              },
              "description": "Filter by capabilities"
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "description": "Max results"
            }
          },
          "additionalProperties": false
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "description": "Pagination offset"
        }
      },
      "required": ["filter"],
      "additionalProperties": false
    }
  },
  "required": ["version", "type", "sender", "epochId", "timestamp", "nonce", "signature", "payload"],
  "additionalProperties": false
}
